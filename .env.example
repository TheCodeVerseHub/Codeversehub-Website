# Site URL (used for sitemap, RSS feed, and metadata)
# Example local value: http://localhost:3000
NEXT_PUBLIC_SITE_URL="Some url"

# Discord channel webhook to receive ban appeals
# Create in Discord: Channel Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_BAN_APPEAL_WEBHOOK_URL="https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY"

# Discord webhook for GitHub organization applications
# Leave blank until you add the webhook in Discord
DISCORD_APPLICATION_WEBHOOK=""

# GitHub personal access token (increases API rate limit from 60 to 5000 req/hr)
# Create at https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN="your_github_token_here"

# Formspree form endpoint (contact form)
# Get at https://formspree.io/ -> New Form -> Copy form ID
NEXT_PUBLIC_FORMSPREE_FORM_ID="your_formspree_form_id_here"

# Cloudflare Turnstile keys (bot protection)
# Get at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your_turnstile_site_key_here"
TURNSTILE_SECRET_KEY="your_turnstile_secret_key_here"
